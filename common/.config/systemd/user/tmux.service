[Unit]
Description=tmux server (persistent across GNOME/GDM session restarts)
Documentation=man:tmux(1)

[Service]
Type=forking
# Start the server with no client; sessions attach to it later.
ExecStart=/usr/bin/tmux new-session -d -s main
ExecStop=/usr/bin/tmux kill-server
Restart=on-failure
# Keep the server alive even when no session is attached.
KillMode=none

[Install]
WantedBy=default.target
